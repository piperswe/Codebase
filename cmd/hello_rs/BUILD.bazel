load("@rules_rust//rust:defs.bzl", "rust_binary")

load("//platforms:binary.bzl", "platform_binary")

rust_binary(
    name = "hello_rs",
    srcs = ["hello.rs"],
)

platform_binary(
    name = "hello_rs_linux_amd64",
    binary = ":hello_rs",
    platform = "//platforms:linux_amd64",
)

platform_binary(
    name = "hello_rs_linux_arm64",
    binary = ":hello_rs",
    platform = "//platforms:linux_arm64",
)
