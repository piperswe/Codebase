load(":package_version.bzl", "package_status_value")

exports_files(
    [
        "package_install_container.sh",
        "package_install_test.sh",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/libc:gnu.2.36",
    ],
    visibility = ["//visibility:public"],
)

package_status_value(
    name = "package_version",
    key = "STABLE_PACKAGE_VERSION",
    visibility = ["//visibility:public"],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
        "@llvm//constraints/libc:gnu.2.36",
    ],
    visibility = ["//visibility:public"],
)
