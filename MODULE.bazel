    patch_strip = 1,
    patches = ["//patches:pg_query_go.patch"],
    path = "github.com/pganalyze/pg_query_go/v6",
)
use_repo(go_deps, "com_github_a_h_templ", "com_github_coreos_go_systemd_v22", "com_github_cyruzin_golang_tmdb", "com_github_darthsim_overmind", "com_github_go_chi_chi_v5", "com_github_go_chi_httplog_v3", "com_github_go_faster_errors", "com_github_go_faster_jx", "com_github_golang_migrate_migrate_v4", "com_github_jackc_pgx_v5", "com_github_joho_godotenv", "com_github_ogen_go_ogen", "com_github_oklog_ulid_v2", "com_github_prometheus_client_golang", "com_github_sqlc_dev_sqlc", "com_github_systemd_slog_journal", "com_github_testcontainers_testcontainers_go", "com_github_testcontainers_testcontainers_go_modules_postgres", "com_github_valkey_io_valkey_go", "com_github_xsam_otelsql", "com_github_yuin_goldmark", "io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp", "io_opentelemetry_go_otel_exporters_prometheus", "io_opentelemetry_go_otel_metric", "io_opentelemetry_go_otel_sdk", "io_opentelemetry_go_otel_sdk_metric", "io_opentelemetry_go_otel_trace", "org_golang_x_crypto", "org_modernc_sqlite")

