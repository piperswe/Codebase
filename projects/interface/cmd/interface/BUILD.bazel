load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//platforms:binary.bzl", "platform_binary")
load("//platforms:oci.bzl", "binary_oci_image")
load("//platforms:packages.bzl", "linux_binary_packages")

go_library(
    name = "interface_lib",
    srcs = ["main.go"],
    importpath = "codebase.bid/projects/interface/cmd/interface",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/go/notify",
        "//projects/interface/internal/version",
    ],
)

go_binary(
    name = "interface",
    embed = [":interface_lib"],
    visibility = ["//visibility:public"],
)

platform_binary(
    name = "interface_linux_gnu_amd64",
    binary = ":interface",
    platform = "//platforms:linux_amd64",
)

platform_binary(
    name = "interface_linux_gnu_arm64",
    binary = ":interface",
    platform = "//platforms:linux_arm64",
)

platform_binary(
    name = "interface_linux_musl_amd64",
    binary = ":interface",
    platform = "@llvm//platforms:linux_amd64_musl",
)

platform_binary(
    name = "interface_linux_musl_arm64",
    binary = ":interface",
    platform = "@llvm//platforms:linux_arm64_musl",
)

binary_oci_image(
    name = "interface_image",
    base = "distroless_base",
    binary = ":interface_linux_gnu_{arch}",
    description = "Social media website",
    entrypoint = ["/interface"],
    title = "interface",
    visibility = ["//visibility:public"],
)

linux_binary_packages(
    name = "interface_linux_packages",
    package_name = "interface",
    binary = ":interface_linux_{libc}_{arch}",
    depends = {
        "deb": [
            "libc6",
            "systemd",
        ],
        "rpm": [
            "glibc",
            "systemd",
        ],
        "apk": [
            "sd-tools",
        ],
        "archlinux": [
            "systemd",
        ],
    },
    description = "Social media website",
    executable_name = "interface",
    install_test_command = [
        "/usr/bin/interface",
        "smoke",
    ],
    visibility = ["//visibility:public"],
)
