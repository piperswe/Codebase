# memode configuration. Copy to .env and fill in what you want to enable.
# A service is enabled only when its credentials are set.

# Server
MEMODE_LISTEN=127.0.0.1:8300
# MEMODE_BASE_URL=https://memode.example.com
# MEMODE_DB=~/.local/share/memode/memode.db
# Protects the consent screen; set this whenever the port is reachable beyond localhost.
# MEMODE_OWNER_PASSWORD=
# Set to 1 to skip OAuth verification on the MCP endpoint (local development only).
# MEMODE_ALLOW_UNAUTHENTICATED=
# Services to keep off even when configured, e.g. mail,telegram
# MEMODE_DISABLE_SERVICES=

# iCloud Mail / Calendar / Contacts (app-specific password, NOT your Apple ID password:
# create one at https://account.apple.com -> Sign-In and Security -> App-Specific Passwords)
# MEMODE_ICLOUD_USER=you@example.com
# MEMODE_ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Kagi Search (https://kagi.com/settings?p=api)
# MEMODE_KAGI_API_KEY=

# Telegram user account (https://my.telegram.org -> App api_id / api_hash).
# The first start asks for the login code (and 2FA password) on stdin.
# MEMODE_TELEGRAM_API_ID=
# MEMODE_TELEGRAM_API_HASH=
# MEMODE_TELEGRAM_PHONE=+15550000000
# MEMODE_TELEGRAM_PASSWORD=

# Static OAuth clients (JSON file, see README). Without it a permissive
# localhost client named memode-local is registered.
# MEMODE_CLIENTS=/etc/memode/clients.json
