load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//platforms:binary.bzl", "platform_binary")
load("//platforms:oci.bzl", "binary_oci_image")
load("//platforms:packages.bzl", "linux_binary_packages", "package_file", "systemd_service_account")

go_library(
    name = "memode_lib",
    srcs = ["main.go"],
    importpath = "codebase.bid/projects/memode/cmd/memode",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/go/codemode",
        "//projects/memode/internal/config",
        "//projects/memode/internal/oauthstore",
        "//projects/memode/internal/server",
        "//projects/memode/internal/services",
        "//projects/memode/internal/store",
        "//projects/memode/internal/version",
    ],
)

go_binary(
    name = "memode",
    embed = [":memode_lib"],
    visibility = ["//visibility:public"],
)

platform_binary(
    name = "memode_linux_gnu_amd64",
    binary = ":memode",
    platform = "//platforms:linux_amd64",
)

platform_binary(
    name = "memode_linux_gnu_arm64",
    binary = ":memode",
    platform = "//platforms:linux_arm64",
)

platform_binary(
    name = "memode_linux_musl_amd64",
    binary = ":memode",
    platform = "@llvm//platforms:linux_amd64_musl",
)

platform_binary(
    name = "memode_linux_musl_arm64",
    binary = ":memode",
    platform = "@llvm//platforms:linux_arm64_musl",
)

binary_oci_image(
    name = "memode_image",
    base = "distroless_base",
    binary = ":memode_linux_gnu_{arch}",
    description = "Personal assistant MCP server",
    entrypoint = ["/memode"],
    title = "memode",
    visibility = ["//visibility:public"],
)

linux_binary_packages(
    name = "memode_linux_packages",
    package_name = "memode",
    binary = ":memode_linux_{libc}_{arch}",
    depends = {
        "deb": [
            "libc6",
            "systemd",
        ],
        "rpm": [
            "glibc",
            "systemd",
        ],
        "apk": [
            "sd-tools",
        ],
        "archlinux": [
            "systemd",
        ],
    },
    description = "Personal assistant MCP server",
    executable_name = "memode",
    extra_files = [
        package_file(
            src = "memode.service",
            destination = "/usr/lib/systemd/system/memode.service",
        ),
        package_file(
            src = "memode.env",
            config = True,
            destination = "/etc/memode/memode.env",
            mode = "0600",
        ),
    ],
    systemd_account = systemd_service_account(
        description = "memode service account",
        home = "/var/lib/memode",
        state_directory = "/var/lib/memode",
        state_directory_mode = "0750",
        user = "memode",
    ),
    systemd_service = "memode.service",
    visibility = ["//visibility:public"],
)
