valkey: docker rm -f yagovalkey; docker run --name yagovalkey -it --rm -p 43257:6379 docker.io/valkey/valkey:9.1.2@sha256:a91d34ab33975b1054e26f1bd9995b268f7e0c507b5ded7f3d181a1a25521630
