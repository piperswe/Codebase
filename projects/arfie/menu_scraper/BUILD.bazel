    deps = [
        "//lib/go/fetchweb",
        "//lib/go/kagi",
        "@com_github_grafana_ai_sdk//provider",
        "@com_github_grafana_ai_sdk_providers_openai//:openai",
        "@com_github_openai_openai_go_v3//option",
    ],
