load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//platforms:binary.bzl", "platform_binary")
load("//platforms:oci.bzl", "binary_oci_image")
load("//platforms:packages.bzl", "linux_binary_packages")

go_library(
    name = "hello_go_lib",
    srcs = ["hello.go"],
    importpath = "codebase.bid/projects/hello_world/hello_go",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "hello_go",
    embed = [":hello_go_lib"],
    visibility = ["//visibility:public"],
)

platform_binary(
    name = "hello_go_linux_amd64",
    binary = ":hello_go",
    platform = "//platforms:linux_amd64",
)

platform_binary(
    name = "hello_go_linux_arm64",
    binary = ":hello_go",
    platform = "//platforms:linux_arm64",
)

binary_oci_image(
    name = "hello_go_image",
    base = "distroless_base",
    binary = ":hello_go_linux_{arch}",
    description = "Hello world implemented in Go",
    entrypoint = ["/hello_go"],
    title = "hello-go",
    visibility = ["//visibility:public"],
)

linux_binary_packages(
    name = "hello_go_linux_packages",
    package_name = "hello-go",
    binary = ":hello_go_linux_{arch}",
    description = "Hello world implemented in Go",
    executable_name = "hello_go",
    install_test_command = ["/usr/bin/hello_go"],
    target_name = "hello_go",
    visibility = ["//visibility:public"],
)

go_test(
    name = "hello_go_test",
    srcs = ["hello_test.go"],
    embed = [":hello_go_lib"],
)
