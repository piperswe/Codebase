load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_image_layer")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@bazel_skylib//lib:partial.bzl", "partial")
load("//platforms:oci.bzl", "multiarch_oci_image")

ts_project(
    name = "hello_ts_js",
    srcs = ["hello.ts"],
    declaration = True,
    source_map = True,
    transpiler = partial.make(
        swc,
        swcrc = "//:.swcrc",
    ),
    tsconfig = "//:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//lib/ts/vector:vector_js",
    ],
)

js_binary(
    name = "hello_ts",
    data = [":hello_ts_js"],
    entry_point = "hello.js",
)

[
    js_image_layer(
        name = "hello_ts_linux_{}_layer".format(arch),
        binary = ":hello_ts",
        platform = "//platforms:linux_{}".format(arch),
        root = "/app",
    )
    for arch in [
        "amd64",
        "arm64",
    ]
]

[
    filegroup(
        name = "hello_ts_linux_{}_app_layer".format(arch),
        srcs = [":hello_ts_linux_{}_layer".format(arch)],
        output_group = "app",
    )
    for arch in [
        "amd64",
        "arm64",
    ]
]

multiarch_oci_image(
    name = "hello_ts_image",
    base = "distroless_nodejs",
    cmd = ["projects/hello_world/hello_ts/hello.js"],
    entrypoint = ["/nodejs/bin/node"],
    tars = [":hello_ts_linux_{arch}_app_layer"],
    visibility = ["//visibility:public"],
    workdir = "/app/projects/hello_world/hello_ts/hello_ts.runfiles/_main",
)
