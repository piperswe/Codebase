# Configure these secrets before enabling datasite.service.
TMDB_API_KEY=
ADMIN_API_KEY=

PORT=3084
METRICS_PORT=9090
SERVER_SRC=https://github.com/piperswe/Codebase/projects/datasite

# Log output format: text (default), json, or journal. Use journal under
# systemd for structured journald fields.
LOG_FORMAT=journal

# Optional OpenTelemetry exporter configuration:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
