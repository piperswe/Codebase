load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//platforms:binary.bzl", "platform_binary")
load("//platforms:oci.bzl", "binary_oci_image")
load("//platforms:packages.bzl", "linux_binary_packages", "package_file", "systemd_service_account")

go_library(
    name = "datasite_lib",
    srcs = [
        "main.go",
        "router.go",
    ],
    embedsrcs = ["openapi.yaml"],
    importpath = "github.com/piperswe/Codebase/projects/datasite/cmd/datasite",
    visibility = ["//visibility:private"],
    deps = [
        "//lib/go/cache",
        "//lib/go/o11y",
        "//projects/datasite/internal/controllers",
        "//projects/datasite/internal/db",
        "//projects/datasite/internal/metrics",
        "//projects/datasite/internal/moviedb",
        "//projects/datasite/internal/oas",
        "//projects/datasite/internal/static",
        "//projects/datasite/internal/version",
        "@com_github_coreos_go_systemd_v22//daemon",
        "@com_github_cyruzin_golang_tmdb//:golang-tmdb",
        "@com_github_go_chi_chi_v5//:chi",
        "@com_github_go_chi_httplog_v3//:httplog",
        "@com_github_joho_godotenv//:godotenv",
        "@com_github_riandyrn_otelchi//:otelchi",
        "@com_github_riandyrn_otelchi//metric",
        "@com_github_xsam_otelsql//:otelsql",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel//codes",
        "@io_opentelemetry_go_otel//semconv/v1.26.0:v1_26_0",
        "@io_opentelemetry_go_otel_metric//:metric",
        "@io_opentelemetry_go_otel_trace//:trace",
    ],
)

go_binary(
    name = "datasite",
    embed = [":datasite_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "datasite_test",
    srcs = [
        "main_test.go",
        "router_test.go",
    ],
    embed = [":datasite_lib"],
    deps = [
        "//projects/datasite/internal/db",
        "@com_github_cyruzin_golang_tmdb//:golang-tmdb",
        "@com_github_go_chi_httplog_v3//:httplog",
        "@org_modernc_sqlite//:sqlite",
    ],
)

platform_binary(
    name = "datasite_linux_amd64",
    binary = ":datasite",
    platform = "//platforms:linux_amd64",
)

platform_binary(
    name = "datasite_linux_arm64",
    binary = ":datasite",
    platform = "//platforms:linux_arm64",
)

binary_oci_image(
    name = "datasite_image",
    base = "distroless_base",
    binary = ":datasite_linux_{arch}",
    entrypoint = ["/datasite"],
    visibility = ["//visibility:public"],
)

linux_binary_packages(
    name = "datasite_linux_packages",
    package_name = "datasite",
    binary = ":datasite_linux_{arch}",
    deb_depends = [
        "libc6",
        "systemd",
    ],
    description = "Movie log web application",
    executable_name = "datasite",
    extra_files = [
        package_file(
            src = "datasite.service",
            destination = "/usr/lib/systemd/system/datasite.service",
        ),
        package_file(
            src = "datasite.env",
            config = True,
            destination = "/etc/datasite/datasite.env",
            mode = "0600",
        ),
    ],
    install_test_command = [
        "/usr/bin/datasite",
        "smoke",
    ],
    rpm_requires = [
        "glibc",
        "systemd",
    ],
    systemd_account = systemd_service_account(
        description = "datasite service account",
        home = "/var/lib/datasite",
        state_directory = "/var/lib/datasite",
        state_directory_mode = "0750",
        user = "datasite",
    ),
    systemd_service = "datasite.service",
    target_name = "datasite",
    visibility = ["//visibility:public"],
)
