package views

import (
	"fmt"
	"net/url"
	"strconv"
)

type AdminDashViewModel struct {
	ServerSrc  string
	SQL        string
	Error      string
	Columns    []string
	Rows       [][]string
	Page       int64
	PageSize   int64
	TotalRows  int64
	TotalPages int64
}

func queryURL(sql string, page, pageSize int64) string {
	v := url.Values{}
	v.Set("sql", sql)
	v.Set("page", strconv.FormatInt(page, 10))
	v.Set("page_size", strconv.FormatInt(pageSize, 10))
	return "/admin/?" + v.Encode()
}

func disabledClass(cond bool) string {
	if cond {
		return " disabled"
	}
	return ""
}

templ AdminDash(vm AdminDashViewModel) {
	@page(vm.ServerSrc) {
		<h1>Admin dash</h1>
		<h2>Tasks</h2>
		<ul>
			<li><a href="/admin/cinemas">Manage cinemas</a></li>
			<li><a href="/admin/cinemas/new">Create cinema</a></li>
			<li><a href="/admin/movie_logs">Manage movie logs</a></li>
			<li><a href="/admin/movie_logs/new">Create movie log</a></li>
			<li><a href="/admin/import">Import from Letterboxd</a></li>
		</ul>
		<hr/>
		<h2>SQL Query Executor</h2>
		<div class="card">
			<div class="card-body">
				<form method="GET" action="/admin/">
					<div class="mb-3">
						<label for="sqlQuery" class="form-label">SQL Query</label>
						<textarea
							class="form-control"
							id="sqlQuery"
							name="sql"
							rows="5"
							placeholder="SELECT * FROM cinemas LIMIT 10"
							required
						>{ vm.SQL }</textarea>
					</div>
					<div class="row">
						<div class="col-md-3">
							<label for="pageSize" class="form-label">Page Size</label>
							<input
								type="number"
								class="form-control"
								id="pageSize"
								name="page_size"
								value={ strconv.FormatInt(vm.PageSize, 10) }
								min="1"
								max="1000"
							/>
						</div>
					</div>
					<input type="hidden" name="page" value="1"/>
					<button type="submit" class="btn btn-primary mt-3">Execute Query</button>
				</form>

				if vm.SQL != "" {
					if vm.Error != "" {
						<div class="alert alert-danger mt-3">
							<strong>Error:</strong> { vm.Error }
						</div>
					} else {
						<div style="margin-top: 2rem;">
							<h3>Results</h3>
							@paginationControls(vm, "top")
							<div class="table-responsive">
								<table class="table table-striped table-sm">
									<thead>
										<tr>
											for _, col := range vm.Columns {
												<th>{ col }</th>
											}
										</tr>
									</thead>
									<tbody>
										if len(vm.Rows) == 0 {
											<tr>
												<td colspan={ fmt.Sprintf("%d", len(vm.Columns)) } class="text-center">No results</td>
											</tr>
										} else {
											for _, row := range vm.Rows {
												<tr>
													for _, val := range row {
														<td>{ val }</td>
													}
												</tr>
											}
										}
									</tbody>
								</table>
							</div>
							@paginationControls(vm, "bottom")
						</div>
					}
				}
			</div>
		</div>
	}
}

templ paginationControls(vm AdminDashViewModel, position string) {
	<nav aria-label="Page navigation">
		<ul class="pagination pagination-sm">
			<li class={ "page-item" + disabledClass(vm.Page <= 1) }>
				<a class="page-link" href={ templ.SafeURL(queryURL(vm.SQL, 1, vm.PageSize)) }>First</a>
			</li>
			<li class={ "page-item" + disabledClass(vm.Page <= 1) }>
				<a class="page-link" href={ templ.SafeURL(queryURL(vm.SQL, vm.Page - 1, vm.PageSize)) }>Previous</a>
			</li>
			<li class="page-item active">
				<span class="page-link">
					Page { strconv.FormatInt(vm.Page, 10) } of { strconv.FormatInt(vm.TotalPages, 10) }
					<span style="margin-left: 1rem; font-weight: normal;">
						({ strconv.FormatInt(vm.TotalRows, 10) } total rows)
					</span>
				</span>
			</li>
			<li class={ "page-item" + disabledClass(vm.Page >= vm.TotalPages) }>
				<a class="page-link" href={ templ.SafeURL(queryURL(vm.SQL, vm.Page + 1, vm.PageSize)) }>Next</a>
			</li>
			<li class={ "page-item" + disabledClass(vm.Page >= vm.TotalPages) }>
				<a class="page-link" href={ templ.SafeURL(queryURL(vm.SQL, vm.TotalPages, vm.PageSize)) }>Last</a>
			</li>
		</ul>
	</nav>
}