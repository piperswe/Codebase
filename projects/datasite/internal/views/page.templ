package views

import "codeberg.org/pmc/Codebase/projects/datasite/internal/version"

templ page(serverSrc string) {
	<!DOCTYPE html>
	<html>
		<head>
			<link rel="stylesheet" href="/static/css/bootstrap.min.css"/>
		</head>
		<body>
			<div class="container">
				{ children... }
				<hr/>
				<p><a href={ serverSrc }>datasite source code</a>, running version { version.Version }. code licensed under AGPL-3.0. contents of this site licensed under CC-BY 4.0.</p>
				<p>movie data from TheMovieDB</p>
			</div>
		</body>
	</html>
}
