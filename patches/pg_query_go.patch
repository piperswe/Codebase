diff --git a/BUILD.bazel b/BUILD.bazel
new file mode 100644
index 0000000..998aa6e
--- /dev/null
+++ b/BUILD.bazel
@@ -0,0 +1,46 @@
+load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
+
+go_library(
+    name = "pg_query_go",
+    srcs = [
+        "makefuncs.go",
+        "pg_query.go",
+        "pg_query.pb.go",
+    ],
+    importpath = "github.com/pganalyze/pg_query_go/v6",
+    importpath_aliases = ["github.com/pganalyze/pg_query_go"],
+    visibility = ["//visibility:public"],
+    deps = [
+        "//parser",
+        "@org_golang_google_protobuf//proto",
+        "@org_golang_google_protobuf//reflect/protoreflect",
+        "@org_golang_google_protobuf//runtime/protoimpl",
+    ],
+)
+
+alias(
+    name = "go_default_library",
+    actual = ":pg_query_go",
+    visibility = ["//visibility:public"],
+)
+
+go_test(
+    name = "pg_query_go_test",
+    srcs = [
+        "benchmark_test.go",
+        "fingerprint_test.go",
+        "is_utility_test.go",
+        "normalize_test.go",
+        "parse_test.go",
+        "split_test.go",
+        "summary_test.go",
+    ],
+    data = glob(["testdata/**"]),
+    deps = [
+        ":pg_query_go",
+        "//parser",
+        "@com_github_google_go_cmp//cmp",
+        "@org_golang_google_protobuf//proto",
+        "@org_golang_google_protobuf//testing/protocmp",
+    ],
+)
